@startuml feedprocessor-pipeline

<style>
root {
  FontName "Times New Roman"
  FontSize 12
}
activityDiagram {
  activity {
    BackgroundColor white
    LineColor black
    LineThickness 1
    RoundCorner 6
  }
  diamond {
    BackgroundColor white
    LineColor black
    LineThickness 1
  }
  arrow {
    LineColor black
    LineThickness 1
  }
  barrier {
    LineColor black
    LineThickness 0.5
    BackgroundColor black
  }
  note {
    BackgroundColor white
    LineColor black
  }
  partition {
    LineColor black
  }
}
</style>

start
:loader;
:parser;
:mapperFlow;
fork
  :Images;
fork again
  :Geocoder;
fork again
  :Unifier;
fork again
  :Equipment;
end fork
:converter;
:counterAggregator;
:sendingGroups;
:sender;
:Kafka;
stop
@enduml
