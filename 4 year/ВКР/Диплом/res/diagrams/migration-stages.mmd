graph TB

    %% invisible connectors between stages
    S1 --> S2
    S2 --> S3

    linkStyle 0 stroke-width:0px
    linkStyle 1 stroke-width:0px

    subgraph S1["Этап 1: теневой запуск"]
        direction LR

        D1[Дилеры] --> O1[Существующий]
        D1 -.-> N1[Новый]

        O1 --> K1[Kafka VOS]
        N1 -.-> C1[Сравнение]
    end

    subgraph S2["Этап 2: канареечный"]
        direction LR

        D2[Дилеры] --> O2["Существующий 90-99%"]
        D2 --> N2["Новый 1-10%"]

        O2 --> K2[Kafka VOS]
        N2 --> K2
    end

    subgraph S3["Этап 3: полный перевод"]
        direction LR

        D3[Дилеры] --> N3["Новый 100%"]
        N3 --> K3[Kafka VOS]
    end